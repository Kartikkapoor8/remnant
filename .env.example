# Copy to .env (gitignored). Every variable is optional: the app picks a fallback and names it in the footer and in GET /api/health.

# ElevenLabs key for voice cloning and text-to-speech. Without it the call button is disabled.
ELEVENLABS_API_KEY=

# ElevenLabs voice id used by apps/web/scripts/sarah-voice.ts to render the six demo call clips.
ELEVENLABS_VOICE_ID=

# River AI key for training/ (train.py, sample.py, serve.py). Without it the model falls back to Anthropic, then to the fixture.
RIVER_API_KEY=

# Anthropic key. Used only when no River adapter is being served: base model plus persona prompt.
ANTHROPIC_API_KEY=

# Anthropic model id override (default claude-opus-5).
ANTHROPIC_MODEL=

# Parent directory of .gbrain/ for the app's brain (default $HOME, i.e. ~/.gbrain). Keep it outside any git worktree.
REMNANT_GBRAIN_HOME=

# Hosted brain: URL of a gbrain HTTP MCP server (gbrain serve --http, or gbrain mcp expose). When set, no local gbrain serve is spawned.
GBRAIN_MCP_URL=

# Bearer token for GBRAIN_MCP_URL (from gbrain mcp grant).
GBRAIN_MCP_TOKEN=

# Where RiverProvider looks for the training/serve.py sidecar (default http://127.0.0.1:8765).
RIVER_SIDECAR_URL=

# Bun API port (default 8787).
PORT=

# Vite dev server port (default 5173).
WEB_PORT=
