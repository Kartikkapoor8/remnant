{
  "name": "remnant",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "demo": "bun run scripts/demo.ts",
    "sarah": "bun run scripts/sarah.ts",
    "dev": "bun run --filter @remnant/web dev",
    "server": "bun run --filter @remnant/web server",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "brain:import": "bun run scripts/import-brain.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
