 {
  "id": "nar5",
  "who": "narr",
  "start": 86.65737142857142,
  "end": 91.14,
  "text": "the memory and the weights are mine, not a company's."
 },
 {
  "id": "nar6",
  "who": "narr",
  "start": 91.74000000000001,
  "end": 94.97,
  "text": "never claims to be alive, never texts first,"
