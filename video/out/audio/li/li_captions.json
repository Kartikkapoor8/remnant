 {
  "id": "nar6",
  "who": "narr",
  "start": 95,
  "end": 97.66,
  "text": "and in a crisis it steps aside."
 },
 {
  "id": "nar7",
  "who": "narr",
  "start": 101.9,
  "end": 104.78,
  "text": "they said, own your intelligence."
